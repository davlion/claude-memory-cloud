// Template: copy to wrangler.local.jsonc (git-ignored) and fill in the <…> values there. scripts/wrangler.sh and
// npm run deploy:* use wrangler.local.jsonc when it exists; tests use this file. See docs/QUICKSTART.md Part 5.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-memory-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "<staging OAUTH_KV id>" },
    { "binding": "CACHE_KV", "id": "<staging CACHE_KV id>" }
  ],
  // Workers rate-limiting binding (available on Free and Paid): 10 requests / 60 s per key on /register and GET /authorize.
  "ratelimits": [
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // SCOPES is a secret (it names clients): npx wrangler secret put SCOPES [--env production] < scopes.<env>.json
  "vars": {
    "PUBLIC_URL": "https://claude-memory-staging.<subdomain>.workers.dev",
    "GITHUB_APP_SLUG": "<staging app slug>",
    "WORKER_VERSION": "0.1.3",
    "MIN_HOOK_VERSION": "0.1.3"
  },
  "env": {
    "production": {
      "name": "claude-memory",
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "<OAUTH_KV id>" },
        { "binding": "CACHE_KV", "id": "<CACHE_KV id>" }
      ],
      "ratelimits": [
        { "name": "AUTH_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
      ],
      "vars": {
        "PUBLIC_URL": "https://claude-memory.<subdomain>.workers.dev",
        "GITHUB_APP_SLUG": "<app slug>",
        "WORKER_VERSION": "0.1.3",
        "MIN_HOOK_VERSION": "0.1.3"
      }
    }
  }
}
